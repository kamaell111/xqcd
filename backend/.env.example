# =================== ZTE OLT Manager — Environment Config ===================
# CARA PAKAI:
#   1. Copy file ini jadi .env         →  cp .env.example .env
#   2. Isi nilai di bawah sesuai OLT-mu
#   3. Jalankan uvicorn
#
# ⚠️ File .env ASLI jangan di-commit ke git (sudah ada di .gitignore).

# =================== Aplikasi ===================
APP_NAME=ZTE OLT Manager
# Generate dengan: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-with-secrets-token-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =================== Database ===================
DATABASE_URL=sqlite:///./data/zte_olt_manager.db

# =================== Scheduler ===================
# Interval polling OLT via Telnet (detik).
#   15 = LAN (server & OLT satu jaringan) — direkomendasikan
#   30 = akses via IP publik / latency tinggi
# Jangan < 10, risiko overlap cycle.
SNMP_POLL_INTERVAL=15
SNMP_TIMEOUT=3
SNMP_RETRIES=2

# =================== SNMP Trap (opsional) ===================
# Trap = notifikasi real-time dari OLT (event-driven).
# Butuh setup manual di sisi OLT + iptables (lihat README).
# Set true HANYA kalau kamu sudah setup trap.
#   false (default) = polling saja, clone-and-run tanpa setup
#   true            = trap aktif (butuh iptables redirect 162→1620)
ENABLE_SNMP_TRAP=false

# =================== Alert Thresholds ===================
ALERT_CPU_WARNING=85.0
ALERT_MEM_WARNING=90.0
ALERT_OPTICAL_RX_WARNING=-25.0
ALERT_OPTICAL_RX_CRITICAL=-28.0
ALERT_AUTO_RESOLVE=True
# DyingGasp = sinyal ONU sebelum mati total (kemungkinan pelanggan cabut adaptor)
# false (default) = kurangi alert noise
# true = catat info alert setiap ada dying_gasp
ALERT_DYING_GASP=false

# VLAN manajemen OLT — tidak bisa dihapus dari UI (proteksi)
# Isi sesuai VLAN yang dipakai untuk akses OLT. Kosongkan (0) kalau tidak ada.
MANAGEMENT_VLAN=0

# =================== SEED DATA (untuk setup pertama) ===================
# Dipakai HANYA saat DB masih kosong / pertama kali dijalankan.
# Setelah DB terisi, perubahan di sini TIDAK mengubah data yang sudah ada.

# --- User default aplikasi ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me
SEED_OPERATOR_USERNAME=zte
SEED_OPERATOR_PASSWORD=change-me
SEED_VIEWER_USERNAME=viewer
SEED_VIEWER_PASSWORD=change-me

# --- OLT target (isi sesuai OLT kamu) ---
SEED_OLT_HOSTNAME=ZXAN
SEED_OLT_IP=10.0.0.1
SEED_OLT_PROTOCOL=telnet
SEED_OLT_PORT=23
SEED_OLT_USERNAME=admin
SEED_OLT_PASSWORD=admin
SEED_OLT_ENABLE_PASSWORD=
SEED_OLT_SNMP_RO=public
SEED_OLT_SNMP_RW=private
